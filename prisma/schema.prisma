generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CONTRIBUTOR    // Any registered engineer (GE/PE) — submit calculators, notes
  VERIFIER      // Professional Engineers (PE/PEPC) — endorse technical accuracy
  MODERATOR     // Core team — manage disputes, flag outdated codes
  ADMIN         // Platform administrators
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?              // Nullable for Google/magic-link users
  image         String?

  // Professional profile
  bemNumber     String?   @unique  // BEM registration number
  role          UserRole  @default(CONTRIBUTOR)
  organisation  String?             // Company or institution
  state         String?             // Malaysian state (e.g., Selangor, Johor)
  specialisation String?            // e.g., Structural, Geotechnical, Hydraulic
  yearsExp      Int?                // Years of experience
  bio           String?

  // Status
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  questions     Question[] @relation("UserQuestions")
  answers       Answer[]   @relation("UserAnswers")
  votes         Vote[]     @relation("UserVotes")
  feedbacks     Feedback[] @relation("UserFeedback")
  savedCalcs    SavedCalc[] @relation("UserSavedCalcs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Q&A Forum ───────────────────────────────────────────────

enum PostType {
  QUESTION      // Standard Q&A question
  FACT          // "Did You Know?" engineering fact
  TERM          // Engineering term / glossary entry
}

model Question {
  id          String   @id @default(cuid())
  postType    PostType @default(QUESTION)
  title       String
  body        String
  tags        String[]           // e.g. ["MSMA", "drainage", "retaining-wall"]
  standardRef String?            // e.g. "MSMA 2nd Ed, Section 4.3"
  isResolved  Boolean  @default(false)
  viewCount   Int      @default(0)

  authorId    String
  author      User     @relation("UserQuestions", fields: [authorId], references: [id], onDelete: Cascade)

  answers     Answer[]
  votes       Vote[]   @relation("QuestionVotes")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  isAccepted Boolean  @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  authorId   String
  author     User     @relation("UserAnswers", fields: [authorId], references: [id], onDelete: Cascade)

  votes      Vote[]   @relation("AnswerVotes")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Vote {
  id    String @id @default(cuid())
  value Int    // +1 upvote, -1 downvote

  userId     String
  user       User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)

  questionId String?
  question   Question? @relation("QuestionVotes", fields: [questionId], references: [id], onDelete: Cascade)

  answerId   String?
  answer     Answer?   @relation("AnswerVotes", fields: [answerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}

// ─── Feedback ───────────────────────────────────────────────

enum FeedbackCategory {
  CALCULATION_ERROR   // Wrong formula or result
  STANDARD_OUTDATED   // Reference standard needs updating
  FEATURE_REQUEST     // New calculator or feature suggestion
  UI_ISSUE            // Layout, usability, or display problem
  OTHER               // General feedback
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESOLVED
  WONT_FIX
}

model Feedback {
  id         String           @id @default(cuid())
  category   FeedbackCategory
  message    String
  pageUrl    String?          // Which calculator page the feedback is about
  status     FeedbackStatus   @default(NEW)

  // Optional link to logged-in user
  userId     String?
  user       User?            @relation("UserFeedback", fields: [userId], references: [id], onDelete: SetNull)

  // Contact for anonymous users
  email      String?

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// ─── Saved Calculations ─────────────────────────────────────

model SavedCalc {
  id         String   @id @default(cuid())
  calcId     String              // Calculator key (e.g. "drain-sizing", "rational-method")
  name       String              // User-given name for the calculation
  values     Json                // Input values as JSON object
  savedAt    DateTime @default(now())

  userId     String
  user       User     @relation("UserSavedCalcs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calcId, name])
  @@index([userId, calcId])
}
